<Page x:Class="Mufteev_Shoe.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mufteev_Shoe"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage" FontFamily="Calibri">

    <Grid Background="#D2F6E7">
        <Border Background="White" CornerRadius="10" Margin="15" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Название товара:" FontSize="16" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="5"/>
                <TextBlock Text="Стоимость (руб):" FontSize="16" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="5"/>
                <TextBlock Text="Состав:" FontSize="16" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Margin="5"/>
                <TextBlock Text="Описание:" FontSize="16" Grid.Column="0" Grid.Row="3" VerticalAlignment="Top" Margin="5,5,5,5"/>
                <TextBlock Text="Остатки на складе:" FontSize="16" Grid.Column="0" Grid.Row="4" VerticalAlignment="Top" FontWeight="Bold" Margin="5,10,5,5"/>

                <TextBox Text="{Binding title}" Grid.Column="1" Grid.Row="0" Height="28" FontSize="16" VerticalContentAlignment="Center" Margin="5"/>
                <TextBox Text="{Binding price}" Grid.Column="1" Grid.Row="1" Height="28" FontSize="16" VerticalContentAlignment="Center" Margin="5"/>
                <TextBox Text="{Binding composition}" Grid.Column="1" Grid.Row="2" Height="28" FontSize="16" VerticalContentAlignment="Center" Margin="5"/>
                <TextBox Text="{Binding description}" Grid.Column="1" Grid.Row="3" Height="55" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" Margin="5"/>

                <DataGrid Name="DGStock" Grid.Column="1" Grid.Row="4" Margin="5,10,5,5" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" FontSize="16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Размер обуви" Binding="{Binding sizes.size_value}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Доступно пар (шт.)" Binding="{Binding quantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Сохранить изменения" Name="BtnSave" Click="BtnSave_Click" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="40" Background="#70B2AF" Foreground="White" FontSize="18" Margin="5,15,5,5"/>
            </Grid>
        </Border>
    </Grid>
</Page>
