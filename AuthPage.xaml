<Page x:Class="Mufteev_Shoe.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mufteev_Shoe"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Calibri">

    <Grid Background="#D2F6E7">
        <!-- Корпоративный фон по ТЗ -->
        <Border Background="White" CornerRadius="10" Width="400" Height="280" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="15" Direction="270" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel Margin="30" VerticalAlignment="Center">
                <TextBlock Text="Авторизация" FontSize="26" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#70B2AF"/>

                <TextBlock Text="Введите логин:" FontSize="16" Margin="0,0,0,5"/>
                <!-- Поле ввода логина -->
                <TextBox Name="TBoxLogin" Height="30" FontSize="16" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <!-- Кнопки действий -->
                <Button Content="Войти" Name="BtnLogin" Click="BtnLogin_Click" 
                        Background="#70B2AF" Foreground="White" Height="35" Width="340" Margin="0,0,0,10"/>

                <Button Content="Войти как гость" Name="BtnGuest" Click="BtnGuest_Click" 
                        Background="Transparent" Foreground="Gray" BorderThickness="0" Height="25" Width="200"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
