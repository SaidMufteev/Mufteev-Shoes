<Page x:Class="Mufteev_Shoe.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mufteev_Shoe"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage" FontFamily="Calibri" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="#D2F6E7">
        <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ваша корзина заказа" FontSize="22" FontWeight="Bold" Foreground="#70B2AF" Margin="5,0,5,15" Grid.Row="0"/>

                <DataGrid Name="DGCart" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" FontSize="16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование товара" Binding="{Binding Product.title}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Выбранный размер" Binding="{Binding SelectedSize.size_value}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Цена за единицу" Binding="{Binding Product.price, StringFormat={}{0:N0} руб.}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Количество (шт.)" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Name="TBlockTotalSum" Text="Итого к оплате: 0 руб." FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Оформить заказ" Name="BtnConfirmOrder" Click="BtnConfirmOrder_Click" Width="180" Height="35" Background="#70B2AF" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
